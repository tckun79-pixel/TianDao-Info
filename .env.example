# TianDao-Info v2.7 — .env.example
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# ── Supabase ─────────────────────────────────────────────────────────────────────
# These values are already exported in ~/.bashrc for convenience:
#   export SUPABASE_URL="https://xqatmutydxsxvrgnuwgm.supabase.co"
#   export SUPABASE_KEY=your-supabase-service-role-key-here
#   export SUPABASE_DB_URL="postgresql://postgres:<pwd>@db.xqatmutydxsxvrgnuwgm.supabase.co:5432/postgres"
#
# If using .env file instead, set them here:
SUPABASE_URL=https://xqatmutydxsxvrgnuwgm.supabase.co
SUPABASE_KEY=your-supabase-service-role-key-here
SUPABASE_DB_URL=postgresql://postgres:your_password@db.xqatmutydxsxvrgnuwgm.supabase.co:5432/postgres

# ── Discord ─────────────────────────────────────────────────────────────────────
# Already in ~/.config/openclaw/discord.env as DISCORD_WEBHOOK_URL.
# Or set it here:
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ── GitHub ──────────────────────────────────────────────────────────────────────
# Used by push_to_github.py for auto-repo creation and authenticated pushes.
# Get a token at: https://github.com/settings/tokens (scopes: repo, workflow)
GITHUB_USER=your_github_username
GITHUB_TOKEN=ghp_your_personal_access_token
